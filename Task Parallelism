import multiprocessing
import time
import os

# Fungsi Koki 1: Menangani panggangan (Steak)
def koki_panggang(pesanan):
    print(f"[KOKI 1] Mulai memanggang {pesanan} (PID: {os.getpid()})")
    time.sleep(3)  # Simulasi waktu memasak yang lama
    print(f"[KOKI 1] SELESAI: {pesanan} siap dihidangkan!")

# Fungsi Koki 2: Membuat minuman (Jus)
def koki_minuman(pesanan):
    print(f"[KOKI 2] Mulai memblender {pesanan} (PID: {os.getpid()})")
    time.sleep(1)  # Simulasi waktu pembuatan singkat
    print(f"[KOKI 2] SELESAI: {pesanan} segar sudah siap!")

# Fungsi Koki 3: Menyiapkan pencuci mulut (Salad)
def koki_salad(pesanan):
    print(f"[KOKI 3] Mulai memotong buah untuk {pesanan} (PID: {os.getpid()})")
    time.sleep(2)  # Simulasi waktu persiapan sedang
    print(f"[KOKI 3] SELESAI: {pesanan} sudah tertata rapi!")

if __name__ == "__main__":
    print("--- DAPUR RESTORAN PARALEL DIBUKA ---\n")
    
    # Mendefinisikan tugas yang berbeda untuk setiap koki
    tugas1 = multiprocessing.Process(target=koki_panggang, args=("Wagyu Steak",))
    tugas2 = multiprocessing.Process(target=koki_minuman, args=("Jus Alpukat",))
    tugas3 = multiprocessing.Process(target=koki_salad, args=("Fruit Salad",))

    waktu_mulai = time.time()

    # Semua koki mulai bekerja secara bersamaan
    tugas1.start()
    tugas2.start()
    tugas3.start()

    # Menunggu sampai koki terakhir selesai (koki panggang yang paling lama)
    tugas1.join()
    tugas2.join()
    tugas3.join()

    waktu_total = time.time() - waktu_mulai
    print(f"\n--- SEMUA PESANAN SELESAI DALAM {waktu_total:.2f} DETIK ---")
    print("Catatan: Jika dikerjakan satu per satu (sekuensial), akan butuh waktu 6 detik!")
